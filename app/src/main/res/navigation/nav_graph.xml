<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.releasethekraken.view.ui.login.LoginFragment"
        android:label="fragment_login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_accountCreateFragment"
            app:destination="@id/accountCreateFragment" />
        <action
            android:id="@+id/action_loginFragment_to_mainMenuFragment"
            app:destination="@id/mainMenuFragment" />
    </fragment>

    <fragment
        android:id="@+id/viewProfileFragment"
        android:name="com.example.releasethekraken.view.ViewProfileFragment"
        android:label="fragment_view_profile"
        tools:layout="@layout/fragment_view_profile">
        <action
            android:id="@+id/action_viewProfileFragment_to_mainMenuFragment"
            app:destination="@id/mainMenuFragment" />
        <action
            android:id="@+id/action_viewProfileFragment_to_notificationFragment"
            app:destination="@id/notificationFragment" />
        <action
            android:id="@+id/action_viewProfileFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_viewProfileFragment_to_accountCreateFragment"
            app:destination="@id/accountCreateFragment" />
    </fragment>

    <fragment
        android:id="@+id/mainMenuFragment"
        android:name="com.example.releasethekraken.view.MainMenuFragment"
        android:label="fragment_main_menu"
        tools:layout="@layout/fragment_main_menu">
        <action
            android:id="@+id/action_mainMenuFragment_to_viewProfileFragment"
            app:destination="@id/viewProfileFragment" />
        <action
            android:id="@+id/action_mainMenuFragment_to_browseEventsFragment"
            app:destination="@id/browseEventsFragment" />
        <action
            android:id="@+id/action_mainMenuFragment_to_notificationFragment"
            app:destination="@id/notificationFragment" />
        <action
            android:id="@+id/action_mainMenuFragment_to_ticketTestFragment"
            app:destination="@id/ticketTestFragment" />
        <action
            android:id="@+id/action_mainMenuFragment_to_qrScanFragment"
            app:destination="@id/qrScanFragment" />
    </fragment>

    <fragment
        android:id="@+id/accountCreateFragment"
        android:name="com.example.releasethekraken.view.ui.login.AccountCreateFragment"
        android:label="fragment_account_create"
        tools:layout="@layout/fragment_account_create">

        <argument
            android:name="isEditMode"
            app:argType="boolean"
            android:defaultValue="false" />

        <action
            android:id="@+id/action_accountCreateFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_accountCreateFragment_to_mainMenuFragment"
            app:destination="@id/mainMenuFragment" />
        <action
            android:id="@+id/action_accountCreateFragment_to_viewProfileFragment"
            app:destination="@id/viewProfileFragment" />
    </fragment>

    <fragment
        android:id="@+id/browseEventsFragment"
        android:name="com.example.releasethekraken.view.BrowseEventsFragment"
        android:label="fragment_browse_events_list"
        tools:layout="@layout/item_event">
        <action
            android:id="@+id/action_browseEventsFragment_to_mainMenuFragment"
            app:destination="@id/mainMenuFragment" />
        <action
            android:id="@+id/action_browseEventsFragment_to_viewProfileFragment"
            app:destination="@id/viewProfileFragment" />
        <action
            android:id="@+id/action_browseEventsFragment_to_notificationFragment"
            app:destination="@id/notificationFragment" />
        <argument
            android:name="yourEvents"
            app:argType="boolean" />
        <action
            android:id="@+id/action_browseEventsFragment_to_createEventFragment"
            app:destination="@id/createEventFragment" />
        <action
            android:id="@+id/action_browseEventsFragment_to_eventDetailsFragment"
            app:destination="@id/eventDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/notificationFragment"
        android:name="com.example.releasethekraken.view.NotificationFragment"
        android:label="fragment_notification"
        tools:layout="@layout/fragment_notification">
        <action
            android:id="@+id/action_notificationFragment_to_viewProfileFragment"
            app:destination="@id/viewProfileFragment" />
        <action
            android:id="@+id/action_notificationFragment_to_mainMenuFragment"
            app:destination="@id/mainMenuFragment" />
    </fragment>
    <fragment
        android:id="@+id/createEventFragment"
        android:name="com.example.releasethekraken.view.CreateEventFragment"
        android:label="fragment_create_event"
        tools:layout="@layout/fragment_create_event" >
        <action
            android:id="@+id/action_createEventFragment_to_browseEventsFragment"
            app:destination="@id/browseEventsFragment" />
        <action
            android:id="@+id/action_createEventFragment_to_eventDetailsFragment"
            app:destination="@id/eventDetailsFragment" />
    </fragment>
    <fragment
        android:id="@+id/eventDetailsFragment"
        android:name="com.example.releasethekraken.view.EventDetailsFragment"
        android:label="fragment_event_details"
        tools:layout="@layout/fragment_event_details" >
        <action
            android:id="@+id/action_eventDetailsFragment_to_browseEventsFragment"
            app:destination="@id/browseEventsFragment" />
        <action
            android:id="@+id/action_eventDetailsFragment_to_createEventFragment"
            app:destination="@id/createEventFragment" />

        <argument
            android:name="UserType"
            app:argType="com.example.releasethekraken.model.UserRole" />

        <!-- FOR QR -->
        <argument
            android:name="eventId"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/ticketTestFragment"
        android:name="com.example.releasethekraken.view.TicketTestFragment"
        android:label="fragment_ticket_test"
        tools:layout="@layout/fragment_ticket_test">
        <action
            android:id="@+id/action_ticketTestFragment_to_mainMenuFragment"
            app:destination="@id/mainMenuFragment" />
    </fragment>

    <!-- QR SCAN FRAGMENT -->
    <fragment
        android:id="@+id/qrScanFragment"
        android:name="com.example.releasethekraken.view.QRScanFragment"
        android:label="fragment_qr_scan"
        tools:layout="@layout/fragment_qr_scan">
        <action
            android:id="@+id/action_qrScanFragment_to_eventDetailsFragment"
            app:destination="@id/eventDetailsFragment" />
    </fragment>

</navigation>