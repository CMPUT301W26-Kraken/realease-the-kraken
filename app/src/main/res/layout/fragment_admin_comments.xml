<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:background="@color/white"
        android:elevation="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Remove Comments"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/dark_blue_text" />

        <ImageButton
            android:id="@+id/notifications_toolbar_button"
            android:layout_width="57dp"
            android:layout_height="57dp"
            android:background="@color/white"
            android:scaleType="center"
            android:src="@android:drawable/ic_popup_reminder"
            app:tint="@color/dark_blue_text" />

        <ImageButton
            android:id="@+id/home_toolbar_button"
            android:layout_width="57dp"
            android:layout_height="57dp"
            android:background="@color/white"
            android:scaleType="fitCenter"
            android:src="@drawable/hometoolbar"
            app:tint="@color/dark_blue_text" />

        <ImageButton
            android:id="@+id/profile_toolbar_button"
            android:layout_width="57dp"
            android:layout_height="57dp"
            android:background="@color/white"
            android:scaleType="fitCenter"
            android:src="@drawable/profiletoolbar"
            app:tint="@color/dark_blue_text" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/admin_comments_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

</LinearLayout>