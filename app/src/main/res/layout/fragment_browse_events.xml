<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:orientation="vertical">

    <!-- Search Section -->
    <LinearLayout
        android:id="@+id/search_bar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/bg_capsule"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <EditText
            android:id="@+id/search_events_text"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="@string/search_events_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:textSize="14sp" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_search"
            app:tint="#1E293B" />
    </LinearLayout>

    <!-- Filters Section -->
    <LinearLayout
        android:id="@+id/browse_filter_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_capsule"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_calendar"
                app:tint="#64748B" />

            <EditText
                android:id="@+id/filter_available_at_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="false"
                android:hint="@string/filter_available_at_hint"
                android:inputType="text"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_capsule"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_myplaces"
                app:tint="#64748B" />

            <EditText
                android:id="@+id/filter_capacity_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:background="@android:color/transparent"
                android:hint="@string/filter_capacity_hint"
                android:inputType="number"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Filter Buttons -->
    <LinearLayout
        android:id="@+id/browse_filter_button_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/apply_filters_button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_apply_filters"
            android:text="@string/apply_filters_button"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/clear_filters_button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_capsule"
            android:text="@string/clear_filters_button"
            android:textAllCaps="false"
            android:textColor="#1E293B"
            android:textStyle="bold"
            app:backgroundTint="@null" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/welcome_header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/welcome_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/browse_events_welcome"
            android:textColor="#001541"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/toggle_detailed_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginTop="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/toggle_detailed_switch"
                android:textColor="#64748B"
                android:textSize="16sp"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/toggle_detailed_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:thumbTint="@color/white"
                app:trackTint="@color/switch_track_selector" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/create_event_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:backgroundTint="@color/light_grey_button"
        android:text="@string/create_event_button"
        android:textColor="@color/dark_blue_text"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/events_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="8dp" />

    <TextView
        android:id="@+id/empty_results_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="32dp"
        android:text="@string/no_matching_events"
        android:textColor="#64748B"
        android:visibility="gone" />

    <include layout="@layout/activity_main" android:visibility="gone"/>

    <!-- Existing bottom toolbar/navigation controls. -->
    <LinearLayout
        android:id="@+id/fullscreen_content_controls"
        style="@style/Widget.Theme.ReleaseTheKraken.ButtonBar.Fullscreen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:background="@color/white"
        android:orientation="horizontal"
        android:elevation="8dp">

        <LinearLayout
            android:id="@+id/NotificationLayout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/notifications_toolbar_button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@color/white"
                android:src="@android:drawable/ic_popup_reminder"
                app:tint="@color/dark_blue_text" />

            <TextView
                android:id="@+id/notifications_toolbar_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/notifications_toolbar"
                android:textAlignment="center"
                android:textSize="12sp"
                android:textColor="@color/dark_blue_text" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/HomeLayout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/home_toolbar_button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@color/white"
                android:scaleType="fitCenter"
                android:src="@drawable/hometoolbar"
                app:tint="@color/dark_blue_text" />

            <TextView
                android:id="@+id/home_toolbar_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_toolbar"
                android:textAlignment="center"
                android:textSize="12sp"
                android:textColor="@color/dark_blue_text" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ProfileLayout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/profile_toolbar_button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@color/white"
                android:scaleType="fitCenter"
                android:src="@drawable/profiletoolbar"
                app:tint="@color/dark_blue_text" />

            <TextView
                android:id="@+id/profile_toolbar_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_toolbar"
                android:textAlignment="center"
                android:textSize="12sp"
                android:textColor="@color/dark_blue_text" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
