<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Search entry point for keyword-based event lookup (#97). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/search_events_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_weight="1"
            android:ems="10"
            android:hint="@string/search_events_hint"
            android:inputType="text" />
    </LinearLayout>

    <!-- Structured filters for timestamp availability and minimum capacity (#83). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/filter_available_at_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="2"
            android:hint="@string/filter_available_at_hint"
            android:inputType="text" />

        <EditText
            android:id="@+id/filter_capacity_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:layout_weight="1"
            android:hint="@string/filter_capacity_hint"
            android:inputType="number" />
    </LinearLayout>

    <!-- Search and filter submission controls. Clear restores the unfiltered event list. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/apply_filters_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/light_grey_button"
            android:text="@string/apply_filters_button"
            android:textColor="@color/dark_blue_text"
            android:textStyle="bold" />

        <Button
            android:id="@+id/clear_filters_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:layout_weight="1"
            android:backgroundTint="@color/light_grey_button"
            android:text="@string/clear_filters_button"
            android:textColor="@color/dark_blue_text"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/welcome_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="@string/browse_events_welcome"
            android:textColor="@color/dark_blue_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/create_event_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            android:layout_weight="1"
            android:backgroundTint="@color/light_grey_button"
            android:text="@string/create_event_button"
            android:textColor="@color/dark_blue_text"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- RecyclerView renders the filtered subset maintained by BrowseEventsFragment. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/events_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp" >

    </androidx.recyclerview.widget.RecyclerView>

    <!-- Empty state shown when the current search/filter combination produces no matches. -->
    <TextView
        android:id="@+id/empty_results_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:text="@string/no_matching_events"
        android:textColor="@color/dark_blue_text"
        android:visibility="gone" />

    <!-- Temporary dummy role controls left in place from the existing browse screen. -->
    <LinearLayout
        android:id="@+id/DummyButtonLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/dummy_organizer_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Organizer" />

        <Button
            android:id="@+id/dummy_entrant_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Entrant" />
    </LinearLayout>

    <!-- Existing bottom toolbar/navigation controls. -->
    <LinearLayout
        android:id="@+id/fullscreen_content_controls"
        style="@style/Widget.Theme.ReleaseTheKraken.ButtonBar.Fullscreen"
        tools:ignore="UselessParent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:background="@color/white"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/NotificationLayout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/notifications_toolbar_button"
                android:layout_width="match_parent"
                android:layout_height="57dp"
                android:background="@color/white"
                android:src="@android:drawable/ic_popup_reminder"
                app:tint="@color/dark_blue_text" />

            <TextView
                android:id="@+id/notifications_toolbar_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/notifications_toolbar"
                android:textAlignment="center"
                android:textColor="@color/dark_blue_text" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/HomeLayout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/home_toolbar_button"
                android:layout_width="match_parent"
                android:layout_height="57dp"
                android:background="@color/white"
                android:scaleType="fitCenter"
                android:src="@drawable/hometoolbar"
                app:tint="@color/dark_blue_text" />

            <TextView
                android:id="@+id/home_toolbar_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_toolbar"
                android:textAlignment="center"
                android:textColor="@color/dark_blue_text" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ProfileLayout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/profile_toolbar_button"
                android:layout_width="match_parent"
                android:layout_height="57dp"
                android:background="@color/white"
                android:scaleType="fitCenter"
                android:src="@drawable/profiletoolbar"
                app:tint="@color/dark_blue_text" />

            <TextView
                android:id="@+id/profile_toolbar_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_toolbar"
                android:textAlignment="center"
                android:textColor="@color/dark_blue_text" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
