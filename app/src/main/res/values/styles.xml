<resources>

    <style name="Widget.Theme.ReleaseTheKraken.ButtonBar.Fullscreen" parent="">
        <item name="android:background">@color/black_overlay</item>
        <item name="android:buttonBarStyle">?android:attr/buttonBarStyle</item>
    </style>

    <style name="ButtonStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:backgroundTint">@color/light_grey_button</item>
        <item name="android:textColor">@color/dark_blue_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DeleteButtonStyle" parent="ButtonStyle">
        <item name="android:backgroundTint">@color/delete_cancel_button</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="StandardMaterialButton" parent="Widget.Material3.Button">
        <item name="cornerRadius">30dp</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:layout_marginLeft">20dp</item>
        <item name="android:layout_marginRight">20dp</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="iconPadding">12dp</item>
        <item name="iconGravity">textStart</item>
        <item name="android:textStyle">bold</item>
        <item name="android:elevation">4dp</item>
    </style>

    <style name="AdminMaterialButton" parent="Widget.Material3.Button">
        <item name="cornerRadius">30dp</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:layout_marginLeft">20dp</item>
        <item name="android:layout_marginRight">20dp</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="iconPadding">12dp</item>
        <item name="iconGravity">textStart</item>
        <item name="android:textStyle">bold</item>
        <item name="android:elevation">6dp</item>
    </style>

</resources>